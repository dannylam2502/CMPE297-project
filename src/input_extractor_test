# ---------------------------------------------------------------------------
# LLM selection
# ---------------------------------------------------------------------------

def get_llm_from_env():
    """
    Initialize an LLM instance using the same pattern as the main pipeline.
    Controlled by env var: LLM_PROVIDER = 'openai' | 'ollama'
    """
    provider = os.getenv("LLM_PROVIDER", "openai").strip().lower()

    if provider == "openai":
        print("[INFO] Using OpenAI backend (llm_openai)")
        return llm_openai()
    elif provider == "ollama":
        print("[INFO] Using Ollama backend (llm_ollama)")
        return llm_ollama()
    else:
        raise ValueError(
            f"Unknown LLM_PROVIDER '{provider}'. "
            "Set LLM_PROVIDER to 'openai' or 'ollama' in your environment."
        )


# ---------------------------------------------------------------------------
# Test runner
# ---------------------------------------------------------------------------

def run_nba_test_case(llm, case, check_category: bool = True):
    """
    Run a single test case.

    Returns:
        (category_ok, extracted_ok)
    """
    cid = case["id"]
    text = case["text"]
    expected_cat = case["expected_category"]
    expected_truth = case["expected_truth"]

    print("=" * 120)
    print(f"[CASE {cid}] INPUT:")
    print(text)
    print("-" * 120)

    try:
        result = extract_claim_from_input(llm, text)
    except Exception as e:
        print(f"[ERROR] extract_claim_from_input failed: {e}")
        return False, False  # treat as failures

    if SHOW_FULL_JSON:
        print("OUTPUT JSON:")
        print(json.dumps(result, indent=2, ensure_ascii=False))

    predicted_cat = result.get("input_category")
    claims = result.get("claims") or []
    normalized = claims[0].get("normalized") if claims else None

    if check_category and expected_cat not in {None, "(n/a)"}:
        category_ok = (predicted_cat == expected_cat)
    else:
        category_ok = True  # don't penalize if we're not checking
    extracted_ok = bool(normalized and isinstance(normalized, str) and normalized.strip())

    print("Key fields:")
    print("  expected_category:", expected_cat)
    print("  predicted_category:", predicted_cat)
    print("  category_match:", "PASS" if category_ok else "FAIL")
    print("  expected_truth_label (ground truth):", expected_truth)
    print("  normalized claim:", normalized)
    print("  original_input:", result.get("original_input"))
    print("  extracted_ok (non-empty normalized claim):", extracted_ok)
    print("=" * 120)
    print()

    return category_ok, extracted_ok


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    # 1) Load .env for API keys and config
    load_dotenv()

    # 2) Initialize LLM backend
    llm = get_llm_from_env()

    # 3) Custom single-input mode
    if len(sys.argv) > 1:
        user_text = " ".join(sys.argv[1:])
        case = {"id": "CUSTOM", "text": user_text,
                "expected_category": "(n/a)", "expected_truth": "(n/a)"}
        run_nba_test_case(llm, case, check_category=False)
        return

    # Stats for base set
    total_base = len(nba_test_cases)
    cat_ok_base = 0
    extracted_ok_base = 0
    truth_pass_base = sum(1 for c in nba_test_cases if c["expected_truth"] == "pass")
    truth_fail_base = sum(1 for c in nba_test_cases if c["expected_truth"] == "fail")

    print("\n" + "#" * 120)
    print("# NBA INPUT EXTRACTOR TEST SUITE – BASE (CLEANER DATA)")
    print("#" * 120 + "\n")

    for case in nba_test_cases:
        cat_ok, ext_ok = run_nba_test_case(llm, case, check_category=True)
        cat_ok_base += int(cat_ok)
        extracted_ok_base += int(ext_ok)

    # Stats for noisy set
    total_noisy = len(nba_noisy_test_cases)
    cat_ok_noisy = 0
    extracted_ok_noisy = 0
    truth_pass_noisy = sum(1 for c in nba_noisy_test_cases if c["expected_truth"] == "pass")
    truth_fail_noisy = sum(1 for c in nba_noisy_test_cases if c["expected_truth"] == "fail")

    print("\n" + "#" * 120)
    print("# NBA INPUT EXTRACTOR TEST SUITE – NOISY (ABBRS / TYPOS / SLANG)")
    print("#" * 120 + "\n")

    for case in nba_noisy_test_cases:
        cat_ok, ext_ok = run_nba_test_case(llm, case, check_category=True)
        cat_ok_noisy += int(cat_ok)
        extracted_ok_noisy += int(ext_ok)

    # 4) Summary
    print("\n" + "#" * 120)
    print("# SUMMARY – BASE SET (100 CASES)")
    print("#" * 120)
    print(f"Total base test cases: {total_base}")
    print(f"Category matches: {cat_ok_base}/{total_base} ({cat_ok_base/total_base*100:.2f}%)")
    print(f"Extraction success (non-empty normalized claim): {extracted_ok_base}/{total_base} "
          f"({extracted_ok_base/total_base*100:.2f}%)")
    print("Ground-truth factual labels in base dataset:")
    print(f"  PASS (factually correct): {truth_pass_base} ({truth_pass_base/total_base*100:.1f}%)")
    print(f"  FAIL (intentionally incorrect): {truth_fail_base} ({truth_fail_base/total_base*100:.1f}%)")

    print("\n" + "#" * 120)
    print("# SUMMARY – NOISY SET")
    print("#" * 120)
    print(f"Total noisy test cases: {total_noisy}")
    print(f"Category matches: {cat_ok_noisy}/{total_noisy} ({cat_ok_noisy/total_noisy*100:.2f}%)")
    print(f"Extraction success (non-empty normalized claim): {extracted_ok_noisy}/{total_noisy} "
          f"({extracted_ok_noisy/total_noisy*100:.2f}%)")
    print("Ground-truth factual labels in noisy dataset:")
    print(f"  PASS (factually correct): {truth_pass_noisy} ({truth_pass_noisy/total_noisy*100:.1f}%)")
    print(f"  FAIL (intentionally incorrect): {truth_fail_noisy} ({truth_fail_noisy/total_noisy*100:.1f}%)")
    print("#" * 120)


